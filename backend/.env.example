# PropIQ Backend — Environment Variables
#
# Copy this file to .env and fill in real values for local development.
# .env is gitignored and must never be committed.
#
# In staging/production, all variables are set in Railway's environment panel.
# Pydantic-settings validates all fields at startup — a missing required variable
# will cause an immediate startup failure with a descriptive error message.

# ---- Database -----------------------------------------------------------
# Full asyncpg connection string.
# Local:      postgresql+asyncpg://propiq:propiq@localhost:5432/propiq
# Railway:    set automatically if using Railway's Postgres plugin, but must
#             use the +asyncpg prefix — Railway provides postgresql:// by default.
DATABASE_URL=postgresql+asyncpg://propiq:propiq@localhost:5432/propiq

# ---- Supabase Auth ------------------------------------------------------
# Project URL and keys — found in Supabase dashboard → Settings → API.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_JWT_SECRET=<jwt-secret>

# ---- Application --------------------------------------------------------
# Controls logging format, docs availability, and CORS behaviour.
# Allowed values: development | staging | production
# In development: CORS allows all origins (*), /docs and /redoc are available.
# In production:  CORS is restricted to ALLOWED_ORIGINS; docs are disabled.
ENVIRONMENT=development

LOG_LEVEL=INFO

# ---- CORS ---------------------------------------------------------------
# Comma-separated list of allowed frontend origins.
# Required in staging/production (ENVIRONMENT != development).
# Missing or empty in production = all cross-origin requests are blocked (401/CORS error).
#
# Example (production):
#   ALLOWED_ORIGINS=https://propiq-platform-production.up.railway.app,http://localhost:3000
#
# Local development: leave empty — ENVIRONMENT=development bypasses this entirely.
ALLOWED_ORIGINS=
