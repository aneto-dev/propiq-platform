# ============================================================
# PropIQ — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ---- Database -----------------------------------------------
# Development database (matches docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://propiq:propiq@localhost:5432/propiq

# Test database (matches docker-compose.test.yml)
TEST_DATABASE_URL=postgresql+asyncpg://propiq:propiq@localhost:5433/propiq_test

# ---- Supabase Auth ------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_JWT_SECRET=your-jwt-secret-here

# ---- Application --------------------------------------------
# development | staging | production
ENVIRONMENT=development

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
