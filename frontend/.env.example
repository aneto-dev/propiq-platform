# PropIQ Frontend — Environment Variables
#
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and must never be committed.
#
# All three variables are required. Missing or incorrect values will cause
# login failures (NEXT_PUBLIC_SUPABASE_*) or API call failures (NEXT_PUBLIC_API_URL).
#
# NEXT_PUBLIC_* variables are baked into the Next.js client bundle at build time.
# Changing them requires a rebuild and redeploy.
#
# Architecture: IMPLEMENTATION_ROADMAP.md Commit 8.4.

# Backend API URL.
# Local development:  http://localhost:8000
# Staging (Railway):  https://propiq-staging.up.railway.app
NEXT_PUBLIC_API_URL=https://propiq-staging.up.railway.app

# Supabase project URL — found in Supabase dashboard → Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase anon (public) key — found in Supabase dashboard → Settings → API.
# Safe to expose in the browser. Do not use the service role key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase-anon-key>
